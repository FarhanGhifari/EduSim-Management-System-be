# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=desktop_pusdatin
DB_DIALECT=postgres

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=amqp://localhost

# Filesystem (local / s3)
FILESYSTEM=local

# S3 / MinIO Configuration
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_NAME=your_bucket_name
S3_PROXY_HOST=http://127.0.0.1:9000
S3_PROXY_PATH=

# Server
PORT=3000
NODE_ENV=development

# tambahkan aja jika dibutuhkan untuk Merge Request
# usage: npm run mr -- --target=<branch target MR> --assign=<username> --review=<username> --commit="<commit messages>" --project="<Project Name SDERP>" --taskname="<Task Name SD ERP>"
# example: npm run mr -- --target=main --assign=SR --review=SR --commit="feat: add login, add sso, add quiz" --project="Sisfo Bahasa Uji Komputer" --taskname="Modul Pengelolaan Pertanyaan Kuis & Ujian - BE Sisfo Bahasa Pengelolaan Uji Komputer"
GITLAB_TOKEN="your_gitlab_token_here"
GITLAB_PROJECT_ID="your_gitlab_project_id_here"
GITLAB_URL="https://your-gitlab-domain/api/v4"

# tambahkan aja jika dibutuhkan untuk Merge Request
WA_BOT_URL="http://your-wa-bot-url"
WA_GROUP_NAME="Your Group Name"
WA_MENTION_ID="628xxxxxxxxxx@c.us"
WA_MENTION_TEXT="@628xxxxxxxxxx"
